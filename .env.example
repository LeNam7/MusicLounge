# LÙNG VÀI TEA — 静心茶室
# Cấu hình Biến Môi Trường Hệ Thống Đặt Lịch & Thông Báo Zalo 2 Chiều

# 1. Xác thực Quản trị viên (/admin)
ADMIN_PASSCODE=serenity2026
ADMIN_SESSION_SECRET=lung-vai-tea-secret-signing-key-2026

# 2. Cấu hình URL & Thời gian giữ chỗ tạm thời (PENDING -> EXPIRED)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOKING_HOLD_HOURS=24

# 3. Đường dẫn cơ sở dữ liệu SQLite (Mặc định: ./data/oriental_serenity.db)
# DATABASE_PATH=./data/oriental_serenity.db

# 4. Kênh Thông Báo Quản Trị Viên qua Zalo Official Account (Zalo OA v3.0 API)
# Hướng dẫn: Đăng ký Zalo OA tại https://oa.zalo.me -> Lấy OA Access Token tại https://developers.zalo.me/tools/explorer
# và lấy user_id của tài khoản Zalo quản trị viên đã quan tâm (follow) OA.
ZALO_OA_ACCESS_TOKEN=
ZALO_ADMIN_USER_ID=

# 5. Kênh Thông Báo Khách Hàng qua Zalo Notification Service (Zalo ZNS)
# Hướng dẫn: Khai báo mã Template ZNS đã được Zalo duyệt cho 3 trạng thái:
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_CONFIRMED=
ZALO_ZNS_TEMPLATE_REJECTED=
ZALO_ZNS_TEMPLATE_CANCELLED=

# 6. Kênh Webhook Tích Hợp Mở Rộng (Tùy chọn: n8n / Make / Zalo Bot Gateway / SMS Gateway)
# Nếu cấu hình URL dưới đây, hệ thống sẽ gửi HTTP POST JSON payload chuẩn tới Webhook tương ứng.
ZALO_WEBHOOK_URL=
CUSTOMER_WEBHOOK_URL=

# 7. Cấu hình Email Thông Báo Quản Trị Viên & Khách Hàng (Gmail SMTP)
ADMIN_NOTIFICATION_EMAIL=your-admin-email@gmail.com
SMTP_USER=your-admin-email@gmail.com
SMTP_PASS=your-16-character-app-password
